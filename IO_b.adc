# =============================================================================
# 映序 B 板（VQ 视频协处理）引脚约束 — P5
#   板型：AC601 核心板 + AC201 载板（与 A 板同构），引脚等同 A 板 IO.adc。
#   顶层：src/user_source/hdl_source/media/vp/yingxu_vq_board_top.v
#   ★ 端口名必须与 RTL 顶层一致（B 板顶层用 ref_clk / tmds_* 无 O_ 前缀）。
#   ★ 本文件只保留 B 板设计用到的信号；A 板专有（I2S/camera/SRAM/seg7/IIC/
#     SD/UART/LED/KEY/SW/BEEP/IR/gpio_*）与 TFT 已删除。
#   ★ SDRAM 无条目：EG4S20 专用 SDRAM 硬接口由 sdram_ip.v 内
#     EG_PHY_SDRAM_2M_32 自动映射，不占通用引脚（与 A 板一致）。
#   ★ 以太网为 RGMII（eth_rxc/rxd[3:0]/rxdv 为 DDR 输入；本设计只收不发，
#     故不约束 eth_gtxc/eth_txd/eth_txen —— 需要发送时再补，且必须先有
#     125MHz TX 时钟源，见 docs/YX_BBOARD_P5_TD_20261123.md）。
# =============================================================================

# ---- 系统时钟 / 复位 ----
set_pin_assignment	{ ref_clk }	{ LOCATION = K14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ rst_n }	{ LOCATION = H14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# ---- HDMI TMDS（LVDS33_E，与 A 板同管脚）----
set_pin_assignment	{ tmds_ch0_p }	{ LOCATION = D11; IOSTANDARD = LVDS33_E; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ tmds_ch1_p }	{ LOCATION = C11; IOSTANDARD = LVDS33_E; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ tmds_ch2_p }	{ LOCATION = F10; IOSTANDARD = LVDS33_E; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ tmds_clk_p }	{ LOCATION = B10; IOSTANDARD = LVDS33_E; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
# DDC：当前 RTL 不发起 EDID 读取（I_edid_read_trig 恒 0）；若接核后启用再放开，
# 注意 DDC_SDA 为 inout、需外部上拉：
# set_pin_assignment	{ tmds_ddc_scl }	{ LOCATION = ?; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
# set_pin_assignment	{ tmds_ddc_sda }	{ LOCATION = ?; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }

# ---- 以太网 PHY（RGMII 接收；-DUSE_ETH 构建）----
set_pin_assignment	{ eth_rxc }	{ LOCATION = F9;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ eth_rxd[0] }	{ LOCATION = F12; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ eth_rxd[1] }	{ LOCATION = H16; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ eth_rxd[2] }	{ LOCATION = G16; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ eth_rxd[3] }	{ LOCATION = F15; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ eth_rxdv }	{ LOCATION = E12; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
# 控制类：PHY 复位（低有效，跟随板级复位）+ MDIO 空闲高（未实现 PHY 配置，
# 见 P5 文档"以太网 bring-up 缺口"）
set_pin_assignment	{ eth_rst_n }	{ LOCATION = C15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ eth_mdc }	{ LOCATION = C16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ eth_mdio }	{ LOCATION = D14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
